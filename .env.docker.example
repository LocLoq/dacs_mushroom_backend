# Copy to .env.docker and replace all CHANGE_ME values before starting.
# Use single quotes around passwords containing $ or # (Compose dotenv syntax).
API_PORT=8080
DB_NAME=mushroom_management
DB_USER=mushroom
DB_PASSWORD='CHANGE_ME_DATABASE_PASSWORD'
DB_ROOT_PASSWORD='CHANGE_ME_ROOT_PASSWORD'
JWT_SECRET='CHANGE_ME_RANDOM_JWT_SECRET'
CLASSIFIER_SERVICE_TOKEN='CHANGE_ME_RANDOM_INTERNAL_TOKEN'
CLASSIFIER_MAX_CONCURRENCY=1
CLASSIFIER_TIMEOUT_MS=120000
# Empty preserves the current wildcard CORS behavior; otherwise comma-separated origins.
CORS_ALLOWED_ORIGINS=
