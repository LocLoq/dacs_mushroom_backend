# Copy to .env.docker and replace all CHANGE_ME values before starting.
# Use single quotes around passwords containing $ or # (Compose dotenv syntax).
API_PORT=8080
DB_NAME=mushroom_management
DB_USER=mushroom
DB_PASSWORD='CHANGE_ME_DATABASE_PASSWORD'
DB_ROOT_PASSWORD='CHANGE_ME_ROOT_PASSWORD'
JWT_SECRET='CHANGE_ME_RANDOM_JWT_SECRET'
CLASSIFIER_SERVICE_TOKEN='CHANGE_ME_RANDOM_INTERNAL_TOKEN'
CLASSIFIER_MAX_CONCURRENCY=1
CLASSIFIER_TIMEOUT_MS=120000
CLASSIFIER_JOB_ATTEMPTS=3
CLASSIFIER_RETRY_BACKOFF_MS=30000
CLASSIFIER_HEALTH_TIMEOUT_MS=2000
CLASSIFIER_HEALTH_CACHE_MS=5000
CLASSIFIER_MONITOR_INTERVAL_MS=10000
CLASSIFIER_ENQUEUE_TIMEOUT_MS=5000
CLASSIFIER_QUEUE_WAIT_MS=300000
CLASSIFIER_MISSING_JOB_GRACE_MS=15000
CLASSIFIER_PROCESSING_TIMEOUT_MS=150000
CLASSIFIER_MONITOR_PAGE_SIZE=100
RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
CLASSIFIER_RATE_LIMIT_MAX=10
# Only set a hop count or trusted proxy addresses/subnets when deploying behind that proxy.
TRUST_PROXY=false
# Empty preserves the current wildcard CORS behavior; otherwise comma-separated origins.
CORS_ALLOWED_ORIGINS=

# Optional push: merge a deploy/.env.<mode>.example profile; see PUSH_HOSTING.md.
PUSH_ENABLED=false
