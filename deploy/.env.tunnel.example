PUSH_HOST_MODE=tunnel
# Replace API_PUBLIC_URL with the Public port 8080 URL from VS Code.
API_PUBLIC_URL=https://YOUR-API-8080.REGION.devtunnels.ms
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
PUSH_ENABLED=false
TRUST_PROXY=1
API_LISTEN_HOST=127.0.0.1
CACHE_ENABLED=true
CACHE_SPECIES_TTL=60
CACHE_GALLERY_TTL=30
CACHE_PROGRESS_TTL=15

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_DIR=./secrets
