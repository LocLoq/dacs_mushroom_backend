PUSH_HOST_MODE=tunnel
# Replace BOTH URLs with the public URLs shown in VS Code Ports.
API_PUBLIC_URL=https://YOUR-API-8080.REGION.devtunnels.ms
NTFY_PUBLIC_URL=https://YOUR-NTFY-8081.REGION.devtunnels.ms
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
NTFY_BIND_ADDRESS=127.0.0.1
NTFY_PORT=8081
PUSH_ENABLED=false
UNIFIEDPUSH_ENABLED=false
APNS_ENABLED=false
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
APNS_KEY_FILE=/run/push/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.example.thu
TRUST_PROXY=1
PUSH_BEHIND_PROXY=true
API_LISTEN_HOST=127.0.0.1
