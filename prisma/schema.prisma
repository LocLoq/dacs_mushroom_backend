datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  users User[]

  @@map("roles")
}

model User {
  id            Int    @id @default(autoincrement())
  username      String @unique @db.VarChar(50)
  password_hash String @db.VarChar(255)
  full_name     String @db.VarChar(100)
  phone_number  String
  email         String
  role_id       Int
  tokenver      Int

  role              Role               @relation(fields: [role_id], references: [id], onDelete: Cascade)
  classifierLookups ClassifierLookup[]
  auditLogs         AuditLog[]
  createdTasks      Task[] @relation("TaskCreator")
  assignedTasks     Task[] @relation("TaskAssignee")

  @@map("users")
}

enum EcologyType {
  SAPROBIC // Hoại sinh (phân hủy mùn hữu cơ)
  MYCORRHIZAL // Cộng sinh (với rễ cây)
  PARASITIC // Ký sinh (trên sinh vật sống khác)
}

enum EdibilityStatus {
  CHOICE // Ngon, tuyệt hảo
  EDIBLE // Ăn được (có thể cần chế biến)
  INEDIBLE // Không ăn được (do mùi vị, kết cấu)
  POISONOUS // Có độc
  DEADLY // Độc chết người
}

enum CultivationDifficulty {
  EASY // Dễ trồng
  MEDIUM // Trung bình
  HARD // Khó trồng
  UNCULTIVABLE // Không thể trồng nhân tạo (vd: nấm cục Truffle)
}

enum FacilityType {
  HOUSEHOLD // Hộ kinh doanh cá thể
  COOPERATIVE // Hợp tác xã
  ENTERPRISE // Doanh nghiệp / Công ty
}

enum FacilityStatus {
  ACTIVE // Đang hoạt động
  SUSPENDED // Tạm ngưng
  CLOSED // Đã đóng cửa
}

enum BatchStatus {
  PREPARATION // Chuẩn bị cơ chất/trại
  INCUBATION // Ủ tơ
  FRUITING // Ra quả thể
  HARVESTING // Đang thu hoạch
  COMPLETED // Đã hoàn tất & dọn trại
  FAILED // Bị hỏng/nhiễm bệnh toàn lô
}

enum ClassifierLookupStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ------------------------------------------------------
// MODELS (Bảng dữ liệu)
// ------------------------------------------------------

model Mushroom {
  id Int @id @default(autoincrement())

  // 1. Phân loại học (Taxonomy)
  scientificName String  @unique @map("scientific_name")
  commonName     String  @map("common_name")
  otherNames     String? @map("other_names")
  family         String
  genus          String

  // 2. Hình thái học (Morphology)
  capDescription   String? @map("cap_description") @db.Text
  gillsDescription String? @map("gills_description") @db.Text
  stemDescription  String? @map("stem_description") @db.Text
  sporePrintColor  String? @map("spore_print_color")
  bruisingBehavior String? @map("bruising_behavior") // Phản ứng đổi màu khi xước

  // 3. Sinh thái & Môi trường sống (Ecology & Habitat)
  ecologyType    EcologyType? @map("ecology_type")
  habitat        String?      @db.Text
  fruitingSeason String?      @map("fruiting_season")

  // 4. Giá trị sử dụng & Độc tính (Edibility & Toxicity)
  edibilityStatus     EdibilityStatus @map("edibility_status")
  toxicitySymptoms    String?         @map("toxicity_symptoms") @db.Text
  medicinalProperties String?         @map("medicinal_properties") @db.Text

  // 5. Nuôi trồng (Cultivation)
  cultivationDifficulty CultivationDifficulty? @map("cultivation_difficulty")

  // 6. Đa phương tiện
  imageUrl String? @map("image_url")

  // Metadata
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  facilities         ProductionFacility[] @relation("FacilityToMushroom")
  cultivationBatches CultivationBatch[]

  @@map("mushroom_species") // Tên bảng thực tế trong Database
}

model ProductionFacility {
  id           Int     @id @default(autoincrement())
  name         String
  taxCode      String? @unique @map("tax_code")
  address      String
  province     String? // Hỗ trợ truy vấn phân vùng địa lý nhanh
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  facilityType        FacilityType   @map("facility_type")
  capacityTonsPerYear Float?         @map("capacity_tons_per_year")
  totalAreaSqm        Float?         @map("total_area_sqm")
  certifications      String? // Ví dụ: "VietGAP, ISO 22000"
  status              FacilityStatus @default(ACTIVE)

  // Quan hệ Nhiều - Nhiều với bảng Giống nấm
  mushrooms Mushroom[] @relation("FacilityToMushroom")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  cultivationBatches CultivationBatch[]

  @@map("production_facilities")
}

model CultivationBatch {
  id        Int    @id @default(autoincrement())
  batchCode String @unique @map("batch_code")

  // Khóa ngoại
  facilityId Int                @map("facility_id")
  mushroomId Int                @map("mushroom_id")
  facility   ProductionFacility @relation(fields: [facilityId], references: [id])
  mushroom   Mushroom           @relation(fields: [mushroomId], references: [id])

  // Trạng thái & Vận hành
  status        BatchStatus @default(PREPARATION)
  substrateType String?     @map("substrate_type")
  spawnSource   String?     @map("spawn_source")
  bagQuantity   Int?        @map("bag_quantity")

  // Tiến độ thời gian
  startDate           DateTime  @map("start_date")
  expectedHarvestDate DateTime? @map("expected_harvest_date")
  endDate             DateTime? @map("end_date")

  // Năng suất & Đánh giá
  actualYieldKg Float?  @map("actual_yield_kg")
  defectRate    Float?  @map("defect_rate") // Tỷ lệ hao hụt (%)
  notes         String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  careLogs       CultivationCareLog[]
  growthRecords  GrowthProgressRecord[]
  harvestRecords HarvestRecord[]
  tasks          Task[]

  @@index([startDate])
  @@index([facilityId, startDate])
  @@index([mushroomId, startDate])
  @@index([status, startDate])
  @@map("cultivation_batches")
}

model Task {
  id             String     @id @default(uuid()) @db.VarChar(36)
  title          String     @db.VarChar(255)
  description    String?    @db.Text
  status         TaskStatus @default(TODO)
  batchId        Int?       @map("batch_id")
  assigneeUserId Int?       @map("assignee_user_id")
  createdByUserId Int?      @map("created_by_user_id")
  dueAt          DateTime?  @map("due_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  batch      CultivationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  assignee   User? @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy  User? @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([assigneeUserId, status])
  @@index([batchId])
  @@map("tasks")
}

model CultivationCareLog {
  id         Int      @id @default(autoincrement())
  batchId    Int      @map("batch_id")
  actionType String   @map("action_type")
  notes      String   @db.Text
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  batch CultivationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("cultivation_care_logs")
}

model GrowthProgressRecord {
  id         Int      @id @default(autoincrement())
  batchId    Int      @map("batch_id")
  stage      String   @map("stage")
  notes      String   @db.Text
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  batch  CultivationBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  images GrowthProgressImage[]

  @@index([batchId, recordedAt])
  @@map("growth_progress_records")
}

model GrowthProgressImage {
  id               Int      @id @default(autoincrement())
  growthProgressId Int      @map("growth_progress_id")
  imageUrl         String   @map("image_url") @db.VarChar(255)
  originalName     String   @map("original_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  fileSize         Int      @map("file_size")
  createdAt        DateTime @default(now()) @map("created_at")

  growthProgress GrowthProgressRecord @relation(fields: [growthProgressId], references: [id], onDelete: Cascade)

  @@index([growthProgressId])
  @@map("growth_progress_images")
}

model HarvestRecord {
  id           Int      @id @default(autoincrement())
  batchId      Int      @map("batch_id")
  harvestedAt  DateTime @default(now()) @map("harvested_at")
  totalYieldKg Float    @map("total_yield_kg")
  qualityGrade String?  @map("quality_grade")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  batch CultivationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([harvestedAt])
  @@index([batchId, harvestedAt])
  @@map("harvest_records")
}

model ClassifierLookup {
  id            String                 @id @default(uuid()) @db.VarChar(36)
  userId        Int?                   @map("user_id")
  originalName  String                 @map("original_name") @db.VarChar(255)
  mimeType      String                 @map("mime_type") @db.VarChar(100)
  fileSize      Int                    @map("file_size")
  status        ClassifierLookupStatus @default(QUEUED)
  result        Json?
  predictedName String?                @map("predicted_name") @db.VarChar(191)
  edibility     String?                @db.VarChar(100)
  confidence    Float?
  errorMessage  String?                @map("error_message") @db.Text
  queuedAt      DateTime               @default(now()) @map("queued_at")
  startedAt     DateTime?              @map("started_at")
  completedAt   DateTime?              @map("completed_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("classifier_lookups")
}

model AuditLog {
  id            Int          @id @default(autoincrement())
  actorUserId   Int?         @map("actor_user_id")
  actorUsername String?      @map("actor_username") @db.VarChar(50)
  actorRole     String?      @map("actor_role") @db.VarChar(50)
  action        String       @db.VarChar(100)
  entityType    String?      @map("entity_type") @db.VarChar(100)
  entityId      String?      @map("entity_id") @db.VarChar(100)
  method        String       @db.VarChar(10)
  path          String       @db.VarChar(255)
  statusCode    Int          @map("status_code")
  outcome       AuditOutcome
  ipAddress     String?      @map("ip_address") @db.VarChar(45)
  userAgent     String?      @map("user_agent") @db.VarChar(512)
  requestId     String?      @map("request_id") @db.VarChar(36)
  durationMs    Int?         @map("duration_ms")
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
